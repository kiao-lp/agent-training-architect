{
  "mcpServers": {
    "duckduckgo": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "duckduckgo-mcp-server==0.6.1",
        "duckduckgo-mcp-server"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "mcp-server-fetch==2026.8.18",
        "mcp-server-fetch"
      ]
    },
    "kiao-files": {
      "type": "stdio",
      "command": "kiao-mcp-files",
      "args": []
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "markitdown-mcp==0.0.1a4",
        "markitdown-mcp"
      ]
    },
    "papers": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "paper-search-mcp==0.1.4",
        "paper-search-mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ]
    },
    "kiao-units": {
      "type": "stdio",
      "command": "kiao-mcp-units",
      "args": []
    },
    "kiao-hybridflow": {
      "type": "stdio",
      "command": "kiao-mcp-hybridflow",
      "args": []
    }
  }
}
